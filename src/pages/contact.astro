---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact — Stratagem Agency"
	description="Ready to scale your affiliate program? Schedule a consultation with the Stratagem team."
>

	<!-- Hero -->
	<section class="bg-[#0a1228] pt-32 pb-20">
		<div class="max-w-7xl mx-auto px-6 lg:px-8">
			<div class="max-w-xl">
				<p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-3">Contact</p>
				<h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight mb-6">
					Let's talk.
				</h1>
				<p class="text-lg text-slate-300 leading-relaxed">
					Whether you're starting an affiliate program from scratch, auditing an existing one, or looking for a strategic partner to scale — we'd love to hear about your goals.
				</p>
			</div>
		</div>
	</section>

	<!-- Contact Options -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

				<!-- Left: What to expect -->
				<div>
					<h2 class="text-2xl font-bold text-gray-900 mb-6">What happens next</h2>
					<ol class="space-y-6">
						{[
							{
								step: '01',
								title: 'Schedule a free 30-min call',
								desc: 'No pitch. Just an honest conversation about where your affiliate program is and where you want it to go.',
							},
							{
								step: '02',
								title: 'We audit your current situation',
								desc: 'We\'ll assess your existing program, competitive landscape, and identify the biggest opportunities.',
							},
							{
								step: '03',
								title: 'You get a clear plan',
								desc: 'A concrete roadmap — what to do, in what order, and what impact to expect. No fluff.',
							},
						].map(({ step, title, desc }) => (
							<li class="flex items-start gap-5">
								<span class="text-3xl font-bold text-blue-400 tabular-nums flex-shrink-0 leading-none mt-0.5">{step}</span>
								<div>
									<h3 class="text-base font-semibold text-gray-900 mb-1">{title}</h3>
									<p class="text-sm text-gray-500 leading-relaxed">{desc}</p>
								</div>
							</li>
						))}
					</ol>

					<div class="mt-12 p-6 rounded-2xl bg-gray-50 border border-gray-100">
						<p class="text-sm text-gray-500 leading-relaxed mb-4">
							Prefer to reach out directly? You can also connect with us on LinkedIn.
						</p>
						<div class="flex flex-col gap-2">
							<a
								href="https://www.linkedin.com/in/mollyob"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-blue-600 transition-colors font-medium"
							>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
								Molly O'Beirne on LinkedIn
							</a>
							<a
								href="https://www.linkedin.com/in/muzio-pesaresi-9b56a987"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-blue-600 transition-colors font-medium"
							>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
								Muzio Pesaresi on LinkedIn
							</a>
						</div>
					</div>
				</div>

				<!-- Right: Contact form -->
				<div>
					<!-- Success / error banners (shown via JS when ?success or ?error in URL) -->
					<div id="banner-success" class="hidden mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium flex items-center gap-3">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
						Message sent! We'll get back to you within 1 business day.
					</div>
					<div id="banner-error" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium flex items-center gap-3">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						Something went wrong. Please try again or email us directly at <a href="mailto:contact@stratagem.agency" class="underline ml-1">contact@stratagem.agency</a>.
					</div>

					<div class="p-8 rounded-2xl border border-gray-100 shadow-sm bg-white">
						<h2 class="text-xl font-bold text-gray-900 mb-6">Send us a message</h2>
						<form
							name="contact"
							method="POST"
							action="/api/contact"
							class="space-y-5"
						>
							<input type="hidden" name="locale" value="en" />
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="first-name" class="block text-xs font-semibold text-gray-700 mb-1.5">First name</label>
									<input
										type="text"
										id="first-name"
										name="first-name"
										required
										class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
										placeholder="Molly"
									/>
								</div>
								<div>
									<label for="last-name" class="block text-xs font-semibold text-gray-700 mb-1.5">Last name</label>
									<input
										type="text"
										id="last-name"
										name="last-name"
										required
										class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
										placeholder="O'Beirne"
									/>
								</div>
							</div>

							<div>
								<label for="email" class="block text-xs font-semibold text-gray-700 mb-1.5">Work email</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
									placeholder="you@company.com"
								/>
							</div>

							<div>
								<label for="company" class="block text-xs font-semibold text-gray-700 mb-1.5">Company</label>
								<input
									type="text"
									id="company"
									name="company"
									class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
									placeholder="Acme Inc."
								/>
							</div>

							<div>
								<label for="goal" class="block text-xs font-semibold text-gray-700 mb-1.5">What's your main goal?</label>
								<select
									id="goal"
									name="goal"
									class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition bg-white"
								>
									<option value="" disabled selected>Select an option</option>
									<option value="launch">Launch a new affiliate program</option>
									<option value="audit">Audit / improve an existing program</option>
									<option value="incrementality">Measure incrementality</option>
									<option value="partners">Recruit better partners</option>
									<option value="platform">Migrate to or optimize Impact.com</option>
									<option value="other">Something else</option>
								</select>
							</div>

							<div>
								<label for="message" class="block text-xs font-semibold text-gray-700 mb-1.5">Tell us more</label>
								<textarea
									id="message"
									name="message"
									rows="4"
									class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
									placeholder="Share some context about your program, your team size, or what's not working..."
								></textarea>
							</div>

							<button
								type="submit"
								class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-colors"
							>
								Send Message
							</button>

							<p class="text-xs text-gray-500 text-center">
								We respond within 1 business day.
							</p>
						</form>
					</div>
				</div>

			</div>
		</div>
	</section>

<script>
	const params = new URLSearchParams(window.location.search);
	if (params.get('success') === 'true') {
		document.getElementById('banner-success')?.classList.remove('hidden');
		// Remove query param from URL without reload
		history.replaceState(null, '', window.location.pathname);
	} else if (params.get('error') === 'true') {
		document.getElementById('banner-error')?.classList.remove('hidden');
		history.replaceState(null, '', window.location.pathname);
	}
</script>

</Layout>
