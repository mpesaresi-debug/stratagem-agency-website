---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page Not Found — Stratagem" description="The page you were looking for couldn't be found." />
	</head>
	<body class="bg-white text-gray-900">
		<Header />

		<main>
			<!-- Hero 404 section -->
			<section class="bg-[#0a1228] min-h-[calc(100vh-80px)] flex items-center pt-24 pb-16">
				<div class="max-w-5xl mx-auto px-6 lg:px-8 w-full">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

						<!-- Left: Unicorn -->
						<div class="flex flex-col items-center md:items-start gap-6">
							<img
								src="https://upload.wikimedia.org/wikipedia/commons/2/28/404UnicornNotFound.svg"
								alt="Unicorn illustration"
								class="w-64 md:w-80 lg:w-96"
							/>
							<p class="text-slate-300 text-lg text-center md:text-left">
								It looks like you found a unicorn, lucky you!
							</p>
						</div>

						<!-- Right: 404 content -->
						<div class="flex flex-col gap-5">
							<p class="text-blue-400 font-extrabold text-8xl sm:text-9xl leading-none tracking-tight">
								404
							</p>
							<h1 class="text-white font-bold text-4xl sm:text-5xl leading-tight -mt-2">
								Ooops.
							</h1>
							<h2 class="text-slate-300 text-xl font-medium leading-snug">
								The page you were looking for couldn't be found.
							</h2>

							<hr class="border-blue-500/30 my-1" />

							<p class="text-slate-400 text-sm">
								You can navigate through our menu or go back to the homepage:
							</p>

							<a
								href="/"
								class="inline-flex items-center gap-2 self-start px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-colors"
							>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
								Back to Homepage
							</a>
						</div>

					</div>
				</div>
			</section>

			<!-- Quick nav links -->
			<section class="py-16 bg-white border-b border-gray-100">
				<div class="max-w-4xl mx-auto px-6 lg:px-8">
					<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 text-center">

						<a href="/" class="group flex flex-col items-center gap-3 p-4 rounded-xl hover:bg-blue-50 transition-colors">
							<div class="w-12 h-12 rounded-full bg-blue-100 group-hover:bg-blue-200 flex items-center justify-center transition-colors">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
							</div>
							<span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors">Home</span>
						</a>

						<a href="/services" class="group flex flex-col items-center gap-3 p-4 rounded-xl hover:bg-blue-50 transition-colors">
							<div class="w-12 h-12 rounded-full bg-blue-100 group-hover:bg-blue-200 flex items-center justify-center transition-colors">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
							</div>
							<span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors">Services</span>
						</a>

						<a href="/#case-studies" class="group flex flex-col items-center gap-3 p-4 rounded-xl hover:bg-blue-50 transition-colors">
							<div class="w-12 h-12 rounded-full bg-blue-100 group-hover:bg-blue-200 flex items-center justify-center transition-colors">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
							</div>
							<span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors">Portfolio</span>
						</a>

						<a href="/#about" class="group flex flex-col items-center gap-3 p-4 rounded-xl hover:bg-blue-50 transition-colors">
							<div class="w-12 h-12 rounded-full bg-blue-100 group-hover:bg-blue-200 flex items-center justify-center transition-colors">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
							</div>
							<span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors">About Us</span>
						</a>

						<a href="/contact" class="group flex flex-col items-center gap-3 p-4 rounded-xl hover:bg-blue-50 transition-colors">
							<div class="w-12 h-12 rounded-full bg-blue-100 group-hover:bg-blue-200 flex items-center justify-center transition-colors">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
							</div>
							<span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors">Contact</span>
						</a>

					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="py-16 bg-white">
				<div class="max-w-4xl mx-auto px-6 lg:px-8">
					<div class="flex flex-col sm:flex-row items-center justify-between gap-6 bg-[#0a1228] rounded-2xl px-8 py-10">
						<h2 class="text-white font-bold text-2xl sm:text-3xl leading-tight text-center sm:text-left">
							See How We Can Help You Grow
						</h2>
						<a
							href="/contact"
							class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-colors whitespace-nowrap"
						>
							Get in Touch
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
