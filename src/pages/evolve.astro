	</section>

	<!-- Sticky CTA, phones only — the booth conversion path -->
	<div
		class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-[#0a1228]/95 p-3 backdrop-blur-sm sm:hidden"
	>
		<a
			href={bookingHref}
			target={isSet(links.booking) ? '_blank' : undefined}
			rel={isSet(links.booking) ? 'noopener noreferrer' : undefined}
			class="flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-blue-500"
		>
			Book a Meeting
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
			>
		</a>
	</div>
	<!-- Keeps the sticky bar from covering the site footer -->
	<div class="h-20 sm:hidden" aria-hidden="true"></div>

	<script is:inline>
		// Log the visit (and its UTM tags) to D1. Inline and fire-and-forget so it
		// never delays the page — this is scanned on booth wifi.
		(function () {
			try {
				var params = new URLSearchParams(window.location.search);
				var payload = JSON.stringify({
					utm_source: params.get('utm_source'),
					utm_medium: params.get('utm_medium'),
					utm_campaign: params.get('utm_campaign'),
					utm_content: params.get('utm_content'),
					utm_term: params.get('utm_term'),
					referrer: document.referrer || null,
					path: window.location.pathname + window.location.search,
					language: navigator.language || null,
				});
				var url = '/api/evolve-view';
				if (navigator.sendBeacon) {
					navigator.sendBeacon(url, new Blob([payload], { type: 'application/json' }));
				} else {
					fetch(url, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: payload,
						keepalive: true,
					});
				}
			} catch (e) {
				/* tracking must never break the page */
			}
		})();
	</script>
</Layout>
