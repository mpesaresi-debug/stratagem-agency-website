---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = 'Performance-based partnership marketing for brands that want to scale sustainably.',
	image,
} = Astro.props;
---

<!doctype html>
<html lang={Astro.url.pathname.startsWith('/it') ? 'it' : 'en'}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="bg-[#0a1228] text-white">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
