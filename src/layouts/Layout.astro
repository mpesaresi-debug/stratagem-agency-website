---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	/** Keep the page out of search results (campaign / landing pages). */
	noindex?: boolean;
}

const {
	title,
	description = 'Performance-based partnership marketing for brands that want to scale sustainably.',
	image,
	noindex = false,
} = Astro.props;

// /zh pages are Simplified Chinese, /it Italian, everything else English.
// NOTE: nothing may precede <!doctype html> below — not even a comment. Astro
// drops the <html>/<head>/<body> wrapper if anything does.
const { pathname } = Astro.url;
const lang = pathname.startsWith('/zh') ? 'zh-Hans' : pathname.startsWith('/it') ? 'it' : 'en';
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={image} noindex={noindex} />
	</head>
	<body class="bg-[#0a1228] text-white">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
