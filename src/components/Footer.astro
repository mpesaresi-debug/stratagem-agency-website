---
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isIT = pathname.startsWith('/it');
const base = isIT ? '/it' : '';
---

<footer class="bg-[#060d1f] border-t border-white/[0.06] text-slate-400">
	<div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-14">
			<!-- Brand -->
			<div class="md:col-span-2">
				<a href={isIT ? '/it' : '/'} class="flex items-center gap-2.5 mb-4">
					<picture>
					<source srcset="/images/logo-icon.webp" type="image/webp" />
					<img src="/images/logo-icon.png" alt="" width="38" height="32" class="h-8 w-auto" aria-hidden="true" loading="lazy" />
				</picture>
				<span class="flex items-baseline gap-1.5 leading-none">
					<span class="font-bold text-white tracking-wide text-base">STRATAGEM</span>
					<span class="font-bold text-slate-400 tracking-wide text-base">AGENCY</span>
				</span>
				</a>
				<p class="text-sm leading-relaxed max-w-xs">
					{isIT
						? 'Marketing di affiliazione basato sulla performance per brand che vogliono crescere in modo sostenibile e misurare ciò che conta.'
						: 'Performance-based partnership marketing for brands that want to scale sustainably and measure what matters.'}
				</p>
				<div class="mt-5 flex items-center gap-3">
					<a
						href="https://www.linkedin.com/company/stratagem-agency-itpt"
						target="_blank"
						rel="noopener noreferrer"
						class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
						aria-label="Stratagem on LinkedIn"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
				</div>
			</div>

			<!-- Services -->
			<div>
				<h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-4">{isIT ? 'Servizi' : 'Services'}</h3>
				<ul class="space-y-2.5 text-sm">
					<li><a href={`${base}/services#program-management`} class="hover:text-white transition-colors">{isIT ? 'Gestione Programma' : 'Program Management'}</a></li>
					<li><a href={`${base}/services#incrementality`} class="hover:text-white transition-colors">{isIT ? 'Incrementalità & Analytics' : 'Incrementality & Analytics'}</a></li>
					<li><a href={`${base}/services#partner-recruitment`} class="hover:text-white transition-colors">{isIT ? 'Reclutamento Partner' : 'Partner Recruitment'}</a></li>
					<li><a href={`${base}/services#commission-optimization`} class="hover:text-white transition-colors">{isIT ? 'Ottimizzazione Commissioni' : 'Commission Optimization'}</a></li>
					<li><a href={`${base}/services#compliance`} class="hover:text-white transition-colors">{isIT ? 'Compliance & Reporting' : 'Compliance & Reporting'}</a></li>
					{/* Not `${base}`-prefixed: this page exists in English and Simplified
					    Chinese only, so an /it/evolve link would 404. It is here to give
					    the page site-wide internal links — it was previously an orphan
					    nothing linked to, which no sitemap entry can make up for. */}
					<li><a href="/evolve" class="hover:text-white transition-colors">{isIT ? 'Brand Cinesi nel Mondo' : 'Chinese Brands Going Global'}</a></li>
				</ul>
			</div>

			<!-- Company -->
			<div>
				<h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-4">{isIT ? 'Azienda' : 'Company'}</h3>
				<ul class="space-y-2.5 text-sm">
					<li><a href={`${base}/about`} class="hover:text-white transition-colors">{isIT ? 'Chi Siamo' : 'About Us'}</a></li>
					<li><a href={`${base}/blog`} class="hover:text-white transition-colors">Blog</a></li>
					<li><a href={`${base}/contact`} class="hover:text-white transition-colors">{isIT ? 'Contattaci' : 'Contact'}</a></li>
				</ul>
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
			<p>© {currentYear} Stratagem Agency · {isIT ? 'Un brand ItalyPoint, Inc. Tutti i diritti riservati.' : 'An ItalyPoint, Inc. brand. All rights reserved.'}</p>
			<div class="flex items-center gap-5">
				<a href={`${base}/privacy`} class="hover:text-white transition-colors">{isIT ? 'Informativa sulla Privacy' : 'Privacy Policy'}</a>
				<a href={`${base}/terms`} class="hover:text-white transition-colors">{isIT ? 'Termini e Condizioni' : 'Terms'}</a>
			</div>
		</div>
	</div>
</footer>
