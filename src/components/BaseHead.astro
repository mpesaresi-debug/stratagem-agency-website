---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Keep the page out of search results (campaign / landing pages). */
	noindex?: boolean;
	/**
	 * Explicit hreflang alternates, for pages whose translations are not the
	 * site-wide EN/IT pair — the /evolve pages are EN + Simplified Chinese.
	 * When set, these replace the default pair rather than adding to it.
	 */
	alternates?: { hreflang: string; path: string }[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image = '/images/logo-icon.png',
	noindex = false,
	alternates,
} = Astro.props;

// hreflang helpers
const pathname = Astro.url.pathname;
// Keep the trailing slash: pages are served at /blog/foo/, so stripping it made
// every hreflang point at a 301. Google wants these to be the canonical URL, not
// a redirect to it.
const enPath = pathname.replace(/^\/it(\/|$)/, '/');
const itPath = pathname.startsWith('/it') ? pathname : `/it${pathname === '/' ? '/' : pathname}`;
const enURL = new URL(enPath, Astro.site);
const itURL = new URL(itPath, Astro.site);
---

<meta charset="utf-8" />
<link rel="preconnect" href="https://images.pexels.com" />
<link rel="preconnect" href="https://lh3.googleusercontent.com" />
<link rel="dns-prefetch" href="https://images.pexels.com" />
<link rel="dns-prefetch" href="https://lh3.googleusercontent.com" />
{import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}></script>
)}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- PWA -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#0a1228" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Stratagem" />
<link rel="apple-touch-icon" href="/images/logo-icon.png" />
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js');
    });
  }
</script>


<!-- Canonical & hreflang -->
<link rel="canonical" href={canonicalURL} />
{
	/* noindex pages have no business advertising translations. Otherwise: an
	   explicit `alternates` list wins, since a page with its own language pair
	   (EN/ZH on /evolve) would otherwise point crawlers at a /it twin that
	   does not exist. */
	!noindex &&
		(alternates
			? alternates.map(({ hreflang, path }) => (
					<link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />
				))
			: (
					<>
						<link rel="alternate" hreflang="en" href={enURL} />
						<link rel="alternate" hreflang="it" href={itURL} />
						<link rel="alternate" hreflang="x-default" href={enURL} />
					</>
				))
}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
