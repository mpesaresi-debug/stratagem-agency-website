{
	"name": "stratagem-agency-website",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./worker-entry.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/about/*",
			"/blog/*",
			"/contact/*",
			"/evolve/*",
			"/it/*",
			"/services/*",
			"/zh/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stratagem-contact-forms",
			"database_id": "7ff40b2e-2694-4abf-a88b-9984da79b69f"
		}
	]
}
